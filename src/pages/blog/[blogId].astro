---
import type { GetStaticPaths } from "astro";
import { compareAsc, parseISO, isValid, getUnixTime, format } from "date-fns";
import { getAllBlogIds, getBlogDetail, type Blog } from "@lib/microcms";
import { TIMEFMT } from "@lib/constants.ts";
import BaseLayout from "@layouts/BaseLayout.astro";
import Main from "@components/Main.astro";

export const prerender = true;
export const getStaticPaths = (async () => {
	const response = await getAllBlogIds();
	return response.map((blogId) => ({
		params: { blogId },
	}));
}) satisfies GetStaticPaths;

const { blogId } = Astro.params;

const blog: Blog = await getBlogDetail(blogId);

const fields: { k: string; v: Date }[] = (() => {
    let fields = [];
    const set = new Set();
    for (const [k, v] of Object.entries(blog)) {
        if (!v || typeof v !== 'string') continue;
        const date = parseISO(v);
        if (!k.match(/At$/) || !isValid(date)) continue;
        const utime = getUnixTime(date);
        if (!set.has(utime)) {
            set.add(getUnixTime(date));
            fields.push({ k, v: date});
        }
    }
    return fields.sort((a, b) => compareAsc(a.v, b.v));
})();
---

<BaseLayout title={blog.title ?? "no_title"}>
    <Main>
        <article>
            <div class="article-info">
				{fields.map((e) => (
                        <div>{e.k}:</div>
                        <div>{format(e.v, TIMEFMT)}</div>
				))}
            </div>
            <div set:html={blog.content}/>
        </article>
    </Main>
</BaseLayout>

<style>
    article {
        margin-bottom: 30px;
        padding: 5px;
    }

    .article-info {
        display: grid;
        grid-template-columns: 1fr 9fr;
        gap: 0.3rem;
        width: 100%;
        color: gray;
        font-size: smaller;
    }
</style>
